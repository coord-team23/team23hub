    {
      "parameters": {
        "jsCode": "const b = $('Webhook').first().json.body || {};\nif (!b.id) throw new Error('Falta el id de la tarea');\nconst filas = $('Leer AdminTasks').all().map(i => i.json).filter(r => r && r.id);\nconst t = filas.find(r => String(r.id) === String(b.id));\nif (!t) throw new Error('Tarea no encontrada en la base');\nif (!t.row_number) throw new Error('No tengo el número de fila de la tarea');\nreturn [{ json: { id: String(t.id), row_number: Number(t.row_number) } }];"
      },
      "id": "d5000015-0000-0000-0000-000000000004",
      "name": "Buscar tarea",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        1700,
        0
      ]
    },
    {
      "parameters": {
        "url": "=https://sheets.googleapis.com/v4/spreadsheets/{{ $('CONFIG').first().json.dbSheetId }}?fields=sheets(properties(sheetId,title))",
        "authentication": "predefinedCredentialType",
        "nodeCredentialType": "googleSheetsOAuth2Api",
        "options": {}
      },
      "id": "d5000015-0000-0000-0000-000000000005",
      "name": "Sheets: metadata",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        1900,
        0
      ],
      "credentials": {
        "googleSheetsOAuth2Api": {
          "id": "REEMPLAZAR",
          "name": "Google Sheets account"
        }
      }
    },
    {
      "parameters": {
        "jsCode": "const meta = $('Sheets: metadata').first().json;\nconst s = (meta.sheets || []).find(x => x.properties && x.properties.title === 'Admin');\nif (!s) throw new Error('No encuentro la pestaña Admin');\nconst gid = s.properties.sheetId;\nconst rn = $('Buscar tarea').first().json.row_number;\nreturn [{ json: { requests: [{ deleteDimension: { range: { sheetId: gid, dimension: 'ROWS', startIndex: rn - 1, endIndex: rn } } }] } }];"
      },
