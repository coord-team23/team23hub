    {
      "parameters": {
        "jsCode": "const body = $('Webhook').first().json.body;\nconst proyecto = body.nombre || '';\nconst cliente = body.cliente || '';\nconst sintesis = body.sintesis || '';\nconst storyboard = body.storyboard_url || '';\nconst timeline = (body.timeline || []).filter(t => t && t.fase);\nconst emails = [];\nObject.entries(body.asignaciones || {}).forEach(([tarea, rows]) => {\n  (rows || []).forEach(r => {\n    if (r && r.email && r.estado === 'candidato') emails.push({ to: r.email, nombre: r.nombre || '', rol: tarea });\n  });\n});\nif (!emails.length) return [{ json: { to: '', subject: 'sin candidatos', html: '' } }];\nconst fmt = d => d || 'a definir';\nconst tlHtml = timeline.length\n  ? '<table style=\"border-collapse:collapse;width:100%;font-size:14px;\"><thead><tr><th style=\"text-align:left;padding:6px 10px;border-bottom:2px solid #0A0A0A;font-size:11px;\">FASE</th><th style=\"text-align:left;padding:6px 10px;border-bottom:2px solid #0A0A0A;font-size:11px;\">INICIO</th><th style=\"text-align:left;padding:6px 10px;border-bottom:2px solid #0A0A0A;font-size:11px;\">FIN</th></tr></thead><tbody>' + timeline.map(t => '<tr><td style=\"padding:6px 10px;border-bottom:1px solid #ddd;\"><b>' + t.fase + '</b></td><td style=\"padding:6px 10px;border-bottom:1px solid #ddd;\">' + fmt(t.inicio) + '</td><td style=\"padding:6px 10px;border-bottom:1px solid #ddd;\">' + fmt(t.fin) + '</td></tr>').join('') + '</tbody></table>'\n  : '<p style=\"color:#8A8A8A;\">Timeline a definir.</p>';\nconst sb = storyboard ? '<p><b>Storyboard / referencias:</b> <a href=\"' + storyboard + '\">' + storyboard + '</a></p>' : '';\nreturn emails.map(e => ({ json: {\n  to: e.to,\n  subject: '🎬 Propuesta TEAM23 — ' + proyecto + ' (' + e.rol + ')',\n  html: '<div style=\"font-family:Helvetica,Arial,sans-serif;color:#0A0A0A;max-width:640px;\">' +\n    '<h2 style=\"margin:0 0 4px;font-size:22px;\">' + proyecto + '</h2>' +\n    '<p style=\"margin:0 0 16px;color:#FF2B1E;font-weight:bold;letter-spacing:2px;font-size:11px;\">PROPUESTA DE PROYECTO · TEAM23</p>' +\n    '<p>Hola ' + (e.nombre || '') + ', te contactamos por un proyecto nuevo' + (cliente ? ' para <b>' + cliente + '</b>' : '') + '. Tu rol propuesto: <b>' + e.rol + '</b>.</p>' +\n    (sintesis ? '<p style=\"margin:14px 0 6px;font-weight:bold;font-size:12px;letter-spacing:1px;\">DE QUÉ SE TRATA</p><p style=\"white-space:pre-line;\">' + sintesis + '</p>' : '') + sb +\n    '<p style=\"margin:14px 0 6px;font-weight:bold;font-size:12px;letter-spacing:1px;\">TIMELINE TENTATIVO</p>' + tlHtml +\n    '<p style=\"margin-top:18px;\">Si te interesa, respondé este mail con tu disponibilidad y presupuesto para el rol.</p>' +\n    '<p style=\"margin-top:22px;font-size:10px;color:#8A8A8A;letter-spacing:2px;\">TEAM23 PRODUCTION HUB</p></div>'\n} }));"
      },
