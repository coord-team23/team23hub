    {
      "parameters": {
        "jsCode": "const ids = $('Discord: IDs').first().json;\nif (!ids.discord_avisos_id) return [];\nconst r = $('Armar registro').first().json.row;\nlet links = {}; try { links = JSON.parse(r.links_json || '{}'); } catch (e) {}\nconst lineas = ['\\ud83d\\ude80 **' + (r.nombre || 'Proyecto') + '** entr\\u00f3 a pre-producci\\u00f3n'];\nconst meta = [];\nif (r.cliente) meta.push('Cliente: ' + r.cliente);\nif (r.agencia) meta.push('Agencia: ' + r.agencia);\nif (meta.length) lineas.push(meta.join(' \\u00b7 '));\nif (links.driveRoot) lineas.push('Drive: <' + links.driveRoot + '>');\nif (links.frameio) lineas.push('Frame.io: <' + links.frameio + '>');\nreturn [{ json: { channelId: ids.discord_avisos_id, content: lineas.join('\\n') } }];"
      },
