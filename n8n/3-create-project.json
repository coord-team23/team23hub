      "waitBetweenTries": 5000
    },
    {
      "parameters": {
        "jsCode": "const b = $('Webhook').first().json.body;\nconst cat = $('Discord: Crear categoría').first().json;\nconst slug = String(b.nombre || 'proyecto').toLowerCase()\n  .normalize('NFD').replace(/[\\u0300-\\u036f]/g, '')\n  .replace(/[^a-z0-9]+/g, '-').replace(/^-+|-+$/g, '').slice(0, 80) || 'proyecto';\n/* Mapa tarea del hub -> sufijo de canal. Agregar lineas aca para mas canales. */\nconst MAPA = { 'Online': 'online', 'VFX': 'vfx', 'Color': 'color' };\nconst tareas = Array.isArray(b.tareas) ? b.tareas : [];\nconst sufijos = ['prod', 'coord', 'general'];\ntareas.forEach(t => { const s = MAPA[t]; if (s && !sufijos.includes(s)) sufijos.push(s); });\nreturn sufijos.map(s => ({ json: { name: slug + '-' + s, parent_id: String(cat.id) } }));"
      },
