      "parameters": {
        "jsCode": "const nombre = $('Webhook').first().json.body.nombre;\nconst l1 = $('Drive: Subcarpetas N1').all().map(i => i.json);\nconst idDe = (kw) => { const f = l1.find(x => (x.name || '').includes(kw)); return f ? f.id : null; };\nconst items = [];\nconst push = (parent, names) => { if (parent) names.forEach(name => items.push({ json: { name, parent } })); };\npush(idDe('COORD'), ['00. PLANTILLAS-DOCUMENTOS','01. KIT DE POST']);\npush(idDe('SUPERVISION'), ['00. OCF','01. PROXY','03. CC']);\npush(idDe('FOOTAGE'), ['00. OCF','01. PROXY','03. CC']);\npush(idDe('RECURSOS'), ['1. [3D]_' + nombre, '2. [GRÁFICAS]_' + nombre, '3. [VFX]_' + nombre, '4. [MOTION]_' + nombre, '5. [CONFORMADO]_' + nombre]);\nreturn items;"
