    {
      "parameters": {
        "jsCode": "const cat = $('Discord: Crear categoría').first().json;\nconst creados = $('Discord: Crear canales').all().map(i => i.json);\nconst general = creados.find(c => (c.name || '').endsWith('-general'));\n/* La columna del sheet se sigue llamando discord_avisos_id, pero guarda el canal -general del proyecto */\nreturn [{ json: {\n  discord_category_id: String(cat.id || ''),\n  discord_avisos_id: general ? String(general.id) : ''\n} }];"
      },
