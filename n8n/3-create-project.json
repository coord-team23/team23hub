    },
    {
      "parameters": {
        "jsCode": "const body = $('Webhook').first().json.body;\nconst root = $('Drive: Crear Unidad').first().json;\nconst l1 = $('Drive: Subcarpetas N1').all().map(i => i.json);\nconst find = (kw) => { const f = l1.find(x => (x.name || '').includes(kw)); return f ? f.id : ''; };\nconst desglose = $('Copia Desglose').first().json;\nconst brief = $('Copia Brief').first().json;\nconst feedback = $('Copia Feedback').first().json;\nconst notas = $('Crear Doc Notas').first().json;\nconst frame = $('Frame: carpetas').first().json;\nconst dsc = $('Discord: IDs').first().json;\nconst folderUrl = (id) => id ? 'https://drive.google.com/drive/folders/' + id : '';\nconst links = {\n  driveRoot: folderUrl(root.id),\n  coord: folderUrl(find('COORD')),\n  supervision: folderUrl(find('SUPERVISION')),\n  footage: folderUrl(find('FOOTAGE')),\n  recursos: folderUrl(find('RECURSOS')),\n  editables: folderUrl(find('EDITABLES')),\n  finales: folderUrl(find('FINALES')),\n  notas: 'https://docs.google.com/document/d/' + notas.id,\n  desglose: 'https://docs.google.com/spreadsheets/d/' + desglose.id,\n  brief: 'https://docs.google.com/presentation/d/' + brief.id,\n  feedback: 'https://docs.google.com/presentation/d/' + feedback.id,\n  frameio: 'https://next.frame.io/project/' + frame.frameProjectId\n};\nconst id = 'p_' + Date.now();\nconst now = new Date().toISOString();\nconst year = String(new Date().getFullYear());\nconst row = {\n  id,\n  nombre: body.nombre,\n  cliente: body.cliente || '',\n  agencia: body.agencia || '',\n  productora: body.productora || '',\n  director: body.director || '',\n  ep_nombre: body.ep_nombre || '', ep_email: body.ep_email || '',\n  prod_nombre: body.prod_nombre || '', prod_email: body.prod_email || '',\n  coord_nombre: body.coord_nombre || '', coord_email: body.coord_email || '',\n  tareas_json: JSON.stringify(body.tareas || []),\n  asignaciones_json: JSON.stringify(body.asignaciones || {}),\n  status: 'por_activarse',\n  year,\n  links_json: JSON.stringify(links),\n  created_at: now,\n  taskDates_json: JSON.stringify(body.taskDates || {}),\n  sintesis: body.sintesis || '',\n  storyboard_url: body.storyboard_url || '',\n  tratamiento_url: body.tratamiento_url || '',\n  discord_category_id: dsc.discord_category_id ? \"'\" + dsc.discord_category_id : '',\n  discord_avisos_id: dsc.discord_avisos_id ? \"'\" + dsc.discord_avisos_id : ''\n};\nconst project = { id, nombre: body.nombre, cliente: body.cliente || '', agencia: body.agencia || '', productora: body.productora || '', director: body.director || '', ep_nombre: body.ep_nombre || '', ep_email: body.ep_email || '', prod_nombre: body.prod_nombre || '', prod_email: body.prod_email || '', coord_nombre: body.coord_nombre || '', coord_email: body.coord_email || '', tareas: body.tareas || [], asignaciones: body.asignaciones || {}, status: 'por_activarse', year, links, calendario: [], taskDates: body.taskDates || {}, sintesis: body.sintesis || '', storyboard_url: body.storyboard_url || '' };\nreturn [{ json: { row, project } }];"
      },
