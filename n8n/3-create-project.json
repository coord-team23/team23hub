    {
      "parameters": {
        "jsCode": "const cfg = $('CONFIG').first().json;\nconst guild = String(cfg.discordGuildId || '').trim();\nconst bot = $('Discord: Qui\\u00e9n soy').first().json;\nconst VIEW = '1024';           /* VIEW_CHANNEL */\nconst VIEW_SEND = '3072';      /* VIEW_CHANNEL + SEND_MESSAGES */\nconst parseIds = v => String(v || '').split(',').map(s => s.trim()).filter(s => /^\\d{5,}$/.test(s));\nconst users = parseIds(cfg.discordViewerUserIds);\nconst roles = parseIds(cfg.discordViewerRoleIds);\nconst overwrites = [\n  { id: guild, type: 0, deny: VIEW },                 /* @everyone: no ve la categoria ni los canales */\n  { id: String(bot.id), type: 1, allow: VIEW_SEND }   /* el bot se garantiza ver y escribir */\n];\nroles.forEach(id => overwrites.push({ id, type: 0, allow: VIEW }));\nusers.forEach(id => overwrites.push({ id, type: 1, allow: VIEW }));\nreturn [{ json: { overwrites } }];"
      },
