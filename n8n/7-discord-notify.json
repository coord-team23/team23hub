{
  "name": "Team23 — 7. Avisar en Discord (checklists)",
  "nodes": [
    {
      "parameters": {
        "httpMethod": "POST",
        "path": "team23/notify",
        "authentication": "headerAuth",
        "responseMode": "responseNode",
        "options": {
          "allowedOrigins": "*"
        }
      },
      "id": "e7000007-0000-0000-0000-000000000001",
      "name": "Webhook",
      "type": "n8n-nodes-base.webhook",
      "typeVersion": 2,
      "position": [
        0,
        0
      ],
      "credentials": {
        "httpHeaderAuth": {
          "id": "REEMPLAZAR",
          "name": "Team23 Key"
        }
      }
    },
    {
      "parameters": {
        "assignments": {
          "assignments": [
            {
              "id": "c1",
              "name": "discordWebhookUrl",
              "value": "PEGAR_URL_DEL_WEBHOOK_DE_DISCORD",
              "type": "string"
            }
          ]
        },
        "includeOtherFields": true,
        "options": {}
      },
      "id": "e7000007-0000-0000-0000-000000000002",
      "name": "CONFIG",
      "type": "n8n-nodes-base.set",
      "typeVersion": 3.4,
      "position": [
        200,
        0
      ]
    },
    {
      "parameters": {
        "jsCode": "const b = $('Webhook').first().json.body || {};\nconst etapaLabel = b.etapa === 'delivery' ? 'Delivery' : b.etapa === 'cierre' ? 'Cierre' : b.etapa === 'gate' ? 'Gate de activación' : (b.etapa || '');\nconst emoji = b.done ? '✅' : '↩️';\nconst accion = b.done ? 'tildó' : 'destildó';\nconst partes = [\n  `${emoji} **${b.proyecto || 'Proyecto'}**${etapaLabel ? ' · ' + etapaLabel : ''}`,\n  `${b.por || 'Alguien'} ${accion}: _${b.item || ''}_`\n];\nif (b.responsable) partes.push(`(responsable: ${b.responsable})`);\nreturn [{ json: { content: partes.join('\\n') } }];"
      },
      "id": "e7000007-0000-0000-0000-000000000003",
      "name": "Armar mensaje",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        420,
        0
      ]
    },
    {
      "parameters": {
        "method": "POST",
        "url": "={{ $('CONFIG').first().json.discordWebhookUrl }}",
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{ JSON.stringify({ content: $json.content }) }}",
        "options": {}
      },
      "id": "e7000007-0000-0000-0000-000000000004",
      "name": "Discord: enviar mensaje",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        640,
        0
      ]
    },
    {
      "parameters": {
        "respondWith": "json",
        "responseBody": "={{ JSON.stringify({ ok: true }) }}",
        "options": {}
      },
      "id": "e7000007-0000-0000-0000-000000000005",
      "name": "Responder",
      "type": "n8n-nodes-base.respondToWebhook",
      "typeVersion": 1.1,
      "position": [
        860,
        0
      ]
    }
  ],
  "connections": {
    "Webhook": { "main": [[{ "node": "CONFIG", "type": "main", "index": 0 }]] },
    "CONFIG": { "main": [[{ "node": "Armar mensaje", "type": "main", "index": 0 }]] },
    "Armar mensaje": { "main": [[{ "node": "Discord: enviar mensaje", "type": "main", "index": 0 }]] },
    "Discord: enviar mensaje": { "main": [[{ "node": "Responder", "type": "main", "index": 0 }]] }
  },
  "active": false,
  "settings": {},
  "pinData": {}
}
