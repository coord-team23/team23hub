    {
      "parameters": {
        "url": "=https://sheets.googleapis.com/v4/spreadsheets/{{ $('CONFIG').first().json.rosterSheetId }}?fields=sheets(properties(sheetId,title))",
        "authentication": "predefinedCredentialType",
        "nodeCredentialType": "googleSheetsOAuth2Api",
        "options": {}
      },
      "id": "ea00000a-0000-0000-0000-000000000009",
      "name": "Roster: metadata",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        1200,
        0
      ],
      "credentials": {
        "googleSheetsOAuth2Api": {
          "id": "REEMPLAZAR",
          "name": "Google Sheets account"
        }
      }
    },
    {
      "parameters": {
        "jsCode": "const meta = $('Roster: metadata').first().json;\nconst hojas = meta.sheets || [];\nconst hoja = hojas.find(s => s.properties && s.properties.sheetId === 0) || hojas[0];\nif (!hoja) throw new Error('El spreadsheet del directorio no tiene pesta\\u00f1as');\nconst title = hoja.properties.title;\nconst b = $('Webhook').first().json.body || {};\nconst base = 'https://sheets.googleapis.com/v4/spreadsheets/' + $('CONFIG').first().json.rosterSheetId + '/values/';\nconst fila = Number(b.fila || 0);\nreturn [{ json: {\n  title,\n  accion: b.accion === 'actualizar' ? 'actualizar' : 'listar',\n  urlLeer: base + encodeURIComponent(title + '!A1:Z2000'),\n  urlLeerFila: base + encodeURIComponent(title + '!A' + fila + ':A' + fila),\n  urlEscribir: base + encodeURIComponent(title + '!A' + fila + ':Z' + fila) + '?valueInputOption=USER_ENTERED'\n} }];"
      },
      "id": "ea00000a-0000-0000-0000-00000000000a",
      "name": "Roster: pestaña",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        1400,
        0
      ]
    },
    {
      "parameters": {
        "conditions": {
          "options": {
