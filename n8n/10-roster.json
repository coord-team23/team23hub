      "id": "ea00000a-0000-0000-0000-00000000000f",
      "name": "Roster: leer fila",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        1800,
        -200
      ],
      "credentials": {
        "googleSheetsOAuth2Api": {
          "id": "REEMPLAZAR",
          "name": "Google Sheets account"
        }
      },
      "alwaysOutputData": true
    },
    {
      "parameters": {
        "jsCode": "const b = $('Webhook').first().json.body || {};\nconst data = $('Roster: leer fila').first().json || {};\nconst actual = String((((data.values || [])[0]) || [])[0] || '').trim();\nconst esperado = String(b.check || '').trim();\nconst valores = Array.isArray(b.valores) ? b.valores.map(x => String(x == null ? '' : x)) : null;\nif (!b.fila || !valores) return [{ json: { ok: false, motivo: 'Pedido incompleto (falta fila o valores)' } }];\nif (actual !== esperado) return [{ json: { ok: false, motivo: 'La fila cambi\\u00f3 en el spreadsheet (esperaba \"' + esperado + '\", hay \"' + actual + '\"). Refresc\\u00e1 la lista y volv\\u00e9 a intentar.' } }];\nreturn [{ json: { ok: true, valores } }];"
      },
