        1600,
        0
      ]
    },
    {
      "parameters": {
        "url": "={{ $('Roster: pestaña').first().json.urlLeer }}",
        "authentication": "predefinedCredentialType",
        "nodeCredentialType": "googleSheetsOAuth2Api",
        "options": {}
      },
      "id": "ea00000a-0000-0000-0000-00000000000c",
      "name": "Roster: leer",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        1800,
        200
      ],
      "credentials": {
        "googleSheetsOAuth2Api": {
          "id": "REEMPLAZAR",
          "name": "Google Sheets account"
        }
      }
    },
    {
      "parameters": {
        "jsCode": "const data = $('Roster: leer').first().json;\nconst values = data.values || [];\nif (!values.length) return [{ json: { ok: true, headers: [], rows: [] } }];\nconst headers = values[0].map(h => String(h || ''));\nconst ancho = headers.length;\nconst rows = values.slice(1).map((v, i) => {\n  const fila = (v || []).map(x => String(x == null ? '' : x));\n  while (fila.length < ancho) fila.push('');\n  return { n: i + 2, v: fila.slice(0, ancho) };\n}).filter(r => r.v.some(x => x !== ''));\nreturn [{ json: { ok: true, headers, rows } }];"
      },
