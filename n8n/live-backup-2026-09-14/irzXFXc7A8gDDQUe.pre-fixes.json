    {
      "id": "998651a3-2ee3-4141-83eb-171dfe1286a7",
      "name": "Aviso de calendario",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        -1216,
        2320
      ],
      "parameters": {
        "jsCode": "const body = $('Webhook').first().json.body || {};\n/* mismo criterio que el mail: sin pedido explícito no se avisa */\nif (body.avisar !== true) return [];\nconst filas = $('Leer Projects').all().map(i => i.json);\nconst p = filas.find(r => String(r.id) === String(body.projectId));\nconst canal = p ? String(p.discord_avisos_id || '').replace(/^'+/, '') : '';\nif (!canal) return [];\nconst rec = $('Reconstruir').first().json;\nconst entradas = body.entries || [];\nconst fases = entradas.filter(e => e.tipo !== 'hito');\nconst hitos = entradas.filter(e => e.tipo === 'hito');\nconst fmt = d => d || 'sin fecha';\nconst lineas = ['\\ud83d\\udcc5 **' + (rec.projectName || p.nombre || 'Proyecto') + '**: ' + (rec.isFirst ? 'calendario definido' : 'calendario actualizado')];\nfases.slice(0, 12).forEach(e => lineas.push('\\u2022 ' + (e.fase || 'Fase') + ': ' + fmt(e.inicio) + ' a ' + fmt(e.fin)));\nhitos.slice(0, 8).forEach(e => lineas.push('\\u25c6 ' + (e.fase || 'Hito') + ': ' + fmt(e.inicio)));\nconst resto = Math.max(0, fases.length - 12) + Math.max(0, hitos.length - 8);\nif (resto > 0) lineas.push('y ' + resto + ' m\\u00e1s en el hub');\nlet content = lineas.join('\\n');\nif (content.length > 1900) content = content.slice(0, 1900) + '\\u2026';\nreturn [{ json: { channelId: canal, content } }];"
      }
    },
