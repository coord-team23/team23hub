        "id": "d7845db2-268a-4dd3-9af2-c6dd21e90667",
        "name": "Reconstruir",
        "type": "n8n-nodes-base.code",
        "typeVersion": 2,
        "position": [
          -2480,
          2432
        ],
        "parameters": {
          "jsCode": "const body = $('Webhook').first().json.body;\nif (!body || !body.projectId) { throw new Error('Falta projectId'); }\nconst now = new Date().toISOString();\nconst existentes = $('Leer Calendario').all().map(i => i.json).filter(r => r && r.project_id && String(r.project_id) !== String(body.projectId));\nconst nuevos = (body.entries || []).map(e => ({\n  project_id: String(body.projectId),\n  fase: e.fase || '',\n  inicio: e.inicio || '',\n  fin: e.fin || '',\n  notas: e.notas || '',\n  tipo: e.tipo === 'hito' ? 'hito' : 'fase',\n  updated_at: now\n}));\nconst rows = existentes.concat(nuevos);\nconst recipients = [...new Set((body.recipients || []).filter(Boolean).map(x => String(x).trim()))].join(',');\nconst fmt = d => d ? d : '-';\nconst cell = 'padding:8px 12px;border-bottom:1px solid #ddd;';\nconst th = 'text-align:left;padding:8px 12px;border-bottom:2px solid #0A0A0A;font-size:11px;letter-spacing:1px;';\nconst fases = nuevos.filter(e => e.tipo !== 'hito');\nconst hitos = nuevos.filter(e => e.tipo === 'hito');\nconst trsF = fases.map(e => '<tr><td style=\"' + cell + '\"><b>' + e.fase + '</b></td><td style=\"' + cell + '\">' + fmt(e.inicio) + '</td><td style=\"' + cell + '\">' + fmt(e.fin) + '</td><td style=\"' + cell + '\">' + (e.notas || '-') + '</td></tr>').join('');\nconst trsH = hitos.map(e => '<tr><td style=\"' + cell + '\">' + fmt(e.inicio) + '</td><td style=\"' + cell + '\"><b>' + e.fase + '</b></td></tr>').join('');\nlet html = '<div style=\"font-family:Helvetica,Arial,sans-serif;color:#0A0A0A;max-width:640px;\">' +\n  '<h2 style=\"margin:0 0 4px;font-size:24px;\">' + (body.projectName || 'Proyecto') + '</h2>' +\n  '<p style=\"margin:0 0 18px;color:#FF2B1E;font-weight:bold;letter-spacing:2px;font-size:11px;\">' + (body.isFirst ? 'CALENDARIO DEFINIDO' : 'CALENDARIO ACTUALIZADO') + ' · TEAM23</p>' +\n  '<table style=\"border-collapse:collapse;width:100%;font-size:14px;\"><thead><tr>' +\n  '<th style=\"' + th + '\">FASE</th><th style=\"' + th + '\">INICIO</th><th style=\"' + th + '\">FIN</th><th style=\"' + th + '\">NOTAS</th>' +\n  '</tr></thead><tbody>' + trsF + '</tbody></table>';\nif (hitos.length) {\n  html += '<p style=\"margin:22px 0 6px;font-weight:bold;font-size:12px;letter-spacing:2px;\">HITOS</p>' +\n    '<table style=\"border-collapse:collapse;width:100%;font-size:14px;\"><thead><tr>' +\n    '<th style=\"' + th + '\">FECHA</th><th style=\"' + th + '\">HITO</th>' +\n    '</tr></thead><tbody>' + trsH + '</tbody></table>';\n}\nhtml += '<p style=\"margin-top:24px;font-size:10px;color:#8A8A8A;letter-spacing:2px;\">TEAM23 PRODUCTION HUB</p></div>';\nreturn [{ json: { rows, recipients, html, projectName: body.projectName || 'Proyecto', isFirst: !!body.isFirst } }];"
        }
      },
