    {
      "parameters": {
        "jsCode": "const catId = $('\\u00bfTiene Discord?').first().json.categoryId;\nconst lista = $('Discord: listar canales').all().map(i => i.json).filter(c => c && c.id);\nconst out = lista.filter(c => String(c.parent_id || '') === catId)\n  .map(c => ({ json: { channelId: String(c.id), nombre: c.name || '' } }));\n/* La categoria se borra al final, cuando ya no tiene hijos */\nout.push({ json: { channelId: catId, nombre: 'categoria' } });\nreturn out;"
      },
