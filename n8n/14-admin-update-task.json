      "parameters": {
        "jsCode": "const b = $('Webhook').first().json.body;\nif (!b || !b.id) { throw new Error('Falta el id de la tarea'); }\n/* solo estos campos se pueden tocar desde acá — pilar/grupo/origen/depth\n   definen la estructura y se siguen editando a mano en el sheet */\nconst campos = ['estado', 'deadline', 'fin', 'nombre', 'prioridad', 'responsable'];\nconst row = { id: String(b.id) };\ncampos.forEach(f => {\n  if (b[f] !== undefined) row[f] = b[f] === null ? '' : String(b[f]);\n});\nif (Object.keys(row).length === 1) { throw new Error('Nada para actualizar (mandá alguno de: estado, deadline, fin, nombre, prioridad, responsable)'); }\nreturn [{ json: row }];"
      },
