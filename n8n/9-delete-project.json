          "mode": "id",
          "value": "={{ $('CONFIG').first().json.dbSheetId }}"
        },
        "sheetName": {
          "__rl": true,
          "mode": "name",
          "value": "Calendar"
        },
        "options": {}
      },
      "id": "e9000009-0000-0000-0000-000000000005",
      "name": "Leer Calendario",
      "type": "n8n-nodes-base.googleSheets",
      "typeVersion": 4.5,
      "position": [
        800,
        0
      ],
      "credentials": {
        "googleSheetsOAuth2Api": {
          "id": "REEMPLAZAR",
          "name": "Google Sheets account"
        }
      },
      "alwaysOutputData": true
    },
    {
      "parameters": {
        "url": "=https://sheets.googleapis.com/v4/spreadsheets/{{ $('CONFIG').first().json.dbSheetId }}?fields=sheets(properties(sheetId,title))",
        "authentication": "predefinedCredentialType",
        "nodeCredentialType": "googleSheetsOAuth2Api",
        "options": {}
      },
      "id": "e9000009-0000-0000-0000-000000000006",
      "name": "Sheets: metadata",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        1000,
        0
      ],
      "credentials": {
        "googleSheetsOAuth2Api": {
          "id": "REEMPLAZAR",
          "name": "Google Sheets account"
        }
      },
      "executeOnce": true
    },
    {
      "parameters": {
        "jsCode": "const meta = $('Sheets: metadata').first().json;\nconst gid = t => {\n  const s = (meta.sheets || []).find(x => x.properties && x.properties.title === t);\n  if (!s) throw new Error('No encuentro la pesta\\u00f1a ' + t);\n  return s.properties.sheetId;\n};\nconst gProjects = gid('Projects');\nconst gCalendar = gid('Calendar');\nconst p = $('Buscar proyecto').first().json;\nconst requests = [];\n/* Filas del calendario del proyecto, de abajo hacia arriba para que no se corran los indices */\nconst cal = $('Leer Calendario').all().map(i => i.json)\n  .filter(r => r && String(r.project_id || '') === p.id && r.row_number);\ncal.map(r => Number(r.row_number)).sort((a, b) => b - a).forEach(rn => {\n  requests.push({ deleteDimension: { range: { sheetId: gCalendar, dimension: 'ROWS', startIndex: rn - 1, endIndex: rn } } });\n});\n/* La fila del proyecto */\nrequests.push({ deleteDimension: { range: { sheetId: gProjects, dimension: 'ROWS', startIndex: p.row_number - 1, endIndex: p.row_number } } });\nreturn [{ json: { requests } }];"
      },
      "id": "e9000009-0000-0000-0000-000000000007",
      "name": "Armar borrado",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        1200,
        0
      ]
    },
    {
