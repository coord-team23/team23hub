      "id": "e9000009-0000-0000-0000-000000000003",
      "name": "Leer Projects",
      "type": "n8n-nodes-base.googleSheets",
      "typeVersion": 4.5,
      "position": [
        400,
        0
      ],
      "credentials": {
        "googleSheetsOAuth2Api": {
          "id": "REEMPLAZAR",
          "name": "Google Sheets account"
        }
      },
      "alwaysOutputData": true
    },
    {
      "parameters": {
        "jsCode": "const b = $('Webhook').first().json.body || {};\nif (!b.id) throw new Error('Falta el id del proyecto');\nconst filas = $('Leer Projects').all().map(i => i.json).filter(r => r && r.id);\nconst p = filas.find(r => String(r.id) === String(b.id));\nif (!p) throw new Error('Proyecto no encontrado en la base');\nif (!p.row_number) throw new Error('No tengo el n\\u00famero de fila del proyecto');\nreturn [{ json: {\n  id: String(p.id),\n  nombre: p.nombre || '',\n  row_number: Number(p.row_number),\n  discord_category_id: String(p.discord_category_id || '').replace(/^'+/, '')\n} }];"
      },
      "id": "e9000009-0000-0000-0000-000000000004",
      "name": "Buscar proyecto",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        600,
        0
      ]
    },
    {
      "parameters": {
        "documentId": {
