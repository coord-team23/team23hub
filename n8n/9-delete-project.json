    {
      "parameters": {
        "jsCode": "const p = $('Buscar proyecto').first().json;\nconst catId = String(p.discord_category_id || '').replace(/^'+/, '').trim();\nif (!catId) return [];\nreturn [{ json: { categoryId: catId } }];"
      },
