      "typeVersion": 4.2,
      "position": [
        220,
        0
      ]
    },
    {
      "parameters": {
        "method": "POST",
        "url": "=https://sheets.googleapis.com/v4/spreadsheets/{{ $json.spreadsheetId }}/values/Projects!A1:append?valueInputOption=RAW",
        "authentication": "predefinedCredentialType",
        "nodeCredentialType": "googleSheetsOAuth2Api",
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{ JSON.stringify({ values: [[ 'id','nombre','cliente','agencia','productora','director','ep_nombre','ep_email','prod_nombre','prod_email','coord_nombre','coord_email','tareas_json','asignaciones_json','status','year','links_json','created_at','taskDates_json','sintesis','storyboard_url','checklist_json','tratamiento_url','tracker_json','discord_category_id','discord_avisos_id' ]] }) }}",
        "options": {}
      },
      "id": "a1000001-0000-0000-0000-000000000003",
      "name": "Headers Projects",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        440,
        0
      ]
    },
    {
      "parameters": {
        "method": "POST",
        "url": "=https://sheets.googleapis.com/v4/spreadsheets/{{ $('Crear Spreadsheet DB').item.json.spreadsheetId }}/values/Calendar!A1:append?valueInputOption=RAW",
        "authentication": "predefinedCredentialType",
        "nodeCredentialType": "googleSheetsOAuth2Api",
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{ JSON.stringify({ values: [[ 'project_id','fase','inicio','fin','notas','tipo','updated_at' ]] }) }}",
        "options": {}
      },
      "id": "a1000001-0000-0000-0000-000000000004",
