              "type": "string"
            },
            {
              "id": "r2",
              "name": "url",
              "value": "={{ 'https://docs.google.com/spreadsheets/d/' + $('Crear Spreadsheet DB').item.json.spreadsheetId }}",
              "type": "string"
            },
            {
              "id": "r3",
              "name": "instruccion",
              "value": "Copiá el dbSheetId y pegalo en el nodo CONFIG de los workflows 2, 3, 4 y 5",
              "type": "string"
            }
          ]
        },
        "options": {}
      },
