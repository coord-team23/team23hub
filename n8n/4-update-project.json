    {
      "parameters": {
        "jsCode": "const meta = $('Roster: metadata').first().json || {};\nconst hojas = meta.sheets || [];\nconst hoja = hojas.find(s => s.properties && s.properties.sheetId === 0) || hojas[0];\nif (!hoja) return [{ json: { urlLeer: '' } }];   /* sin roster el flujo sigue, solo pierde el fallback */\nconst base = 'https://sheets.googleapis.com/v4/spreadsheets/' + $('CONFIG').first().json.rosterSheetId + '/values/';\nreturn [{ json: { urlLeer: base + encodeURIComponent(hoja.properties.title + '!A1:Z2000') } }];"
