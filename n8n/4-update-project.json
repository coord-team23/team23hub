    {
      "parameters": {
        "jsCode": "const a = $('Armar accesos').first().json;\nif (a.motivo !== 'activacion' || !a.generalId) return [];\nif (!a.conAcceso.length && !a.sinMatch.length && !a.sinTag.length) return [];\nconst lineas = ['\\ud83d\\udd13 **' + a.nombreProyecto + '**: accesos del equipo confirmado'];\nif (a.conAcceso.length) lineas.push('Con acceso: ' + a.conAcceso.join(', '));\nif (a.sinMatch.length) lineas.push('\\u26a0 No est\\u00e1n en el servidor o el tag no coincide: ' + a.sinMatch.join(', '));\nif (a.sinTag.length) lineas.push('\\u26a0 Sin tag de Discord cargado: ' + a.sinTag.join(', '));\nreturn [{ json: { channelId: a.generalId, content: lineas.join('\\n').slice(0, 1900) } }];"
      },
