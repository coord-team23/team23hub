      "waitBetweenTries": 5000,
      "executeOnce": true
    },
    {
      "parameters": {
        "jsCode": "const gate = $('\\u00bfDar accesos?').first().json;\nconst filas = $('Projects (accesos)').all().map(i => i.json).filter(r => r && r.id);\nconst p = filas.find(r => String(r.id) === gate.id);\nif (!p) return [];\nconst status = String(p.status || '');\nif (gate.motivo === 'equipo' && !['activo','entregando','cierre'].includes(status)) return [];\nconst catId = String(p.discord_category_id || '').replace(/^'+/, '');\nconst generalId = String(p.discord_avisos_id || '').replace(/^'+/, '');\nif (!catId && !generalId) return [];\nlet asigs = {}; try { asigs = JSON.parse(p.asignaciones_json || '{}'); } catch (e) {}\nconst norm = s => String(s || '').normalize('NFD').replace(/[\\u0300-\\u036f]/g, '').trim().toLowerCase();\nconst normTag = s => String(s || '').toLowerCase().replace(/^@+/, '').replace(/[^a-z0-9._]/g, '');\n/* fallback: tag de discord desde el roster, por nombre */\nconst rosterTag = new Map();\ntry {\n  const vals = ($('Roster: leer').first().json || {}).values || [];\n  if (vals.length) {\n    const heads = vals[0].map(norm);\n    const iN = heads.findIndex(h => h.includes('nombre'));\n    const iD = heads.findIndex(h => h.includes('discord'));\n    if (iN >= 0 && iD >= 0) vals.slice(1).forEach(v => {\n      const n = norm((v || [])[iN]); const d = normTag((v || [])[iD]);\n      if (n && d) rosterTag.set(n, d);\n    });\n  }\n} catch (e) {}\n/* canales del proyecto */\nconst canales = $('Discord: canales del guild').all().map(i => i.json).filter(c => c && c.id && String(c.parent_id || '') === catId);\nconst canalPor = suf => { const c = canales.find(x => String(x.name || '').endsWith('-' + suf)); return c ? String(c.id) : ''; };\nconst MAPA = { 'Online': 'online', 'VFX': 'vfx', 'Color': 'color' };   /* espejo del workflow 3 */\n/* miembros del servidor: username normalizado -> id */\nconst porUser = new Map();\n$('Discord: miembros').all().map(i => i.json).filter(m => m && m.user).forEach(m => {\n  porUser.set(normTag(m.user.username), String(m.user.id));\n  if (m.user.global_name && !porUser.has(normTag(m.user.global_name))) porUser.set(normTag(m.user.global_name), String(m.user.id));\n});\nconst grants = new Map(), conAcceso = new Set(), sinMatch = new Set(), sinTag = new Set();\nObject.entries(asigs).forEach(([tarea, rows]) => {\n  (rows || []).forEach(r => {\n    if (!r || (r.estado && r.estado !== 'confirmado')) return;   /* solo confirmados (sin estado = agregado directo) */\n    const nombre = String(r.nombre || '').trim();\n    if (!nombre) return;\n    const tag = normTag(r.discord) || rosterTag.get(norm(nombre)) || '';\n    if (!tag) { sinTag.add(nombre); return; }\n    const uid = porUser.get(tag);\n    if (!uid) { sinMatch.add(nombre + ' (' + tag + ')'); return; }\n    conAcceso.add(nombre);\n    const chs = [];\n    if (generalId) chs.push({ ch: generalId, allow: '3072' });   /* ver + escribir */\n    if (catId) chs.push({ ch: catId, allow: '1024' });           /* ver la categoria para que quede agrupado */\n    const suf = MAPA[tarea];\n    const tCh = suf ? canalPor(suf) : '';\n    if (tCh) chs.push({ ch: tCh, allow: '3072' });\n    chs.forEach(x => grants.set(x.ch + '|' + uid, { channelId: x.ch, userId: uid, allow: x.allow }));\n  });\n});\nreturn [{ json: { motivo: gate.motivo, nombreProyecto: p.nombre || 'Proyecto', generalId,\n  grants: [...grants.values()], conAcceso: [...conAcceso], sinMatch: [...sinMatch], sinTag: [...sinTag] } }];"
      },
