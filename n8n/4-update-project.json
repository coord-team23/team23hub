    {
      "parameters": {
        "jsCode": "const b = $('Webhook').first().json.body;\nif (!b || !b.id) { throw new Error('Falta el id del proyecto'); }\nconst row = { id: String(b.id) };\nconst campos = ['nombre','cliente','agencia','productora','director','ep_nombre','ep_email','prod_nombre','prod_email','coord_nombre','coord_email','status','year','tareas_json','asignaciones_json','links_json','taskDates_json','sintesis','storyboard_url','tratamiento_url','checklist_json','tracker_json'];\ncampos.forEach(f => {\n  if (b[f] !== undefined && b[f] !== null) {\n    row[f] = typeof b[f] === 'string' ? b[f] : JSON.stringify(b[f]);\n  }\n});\nif (b.tareas !== undefined && b.tareas_json === undefined) row.tareas_json = JSON.stringify(b.tareas);\nif (b.asignaciones !== undefined && b.asignaciones_json === undefined) row.asignaciones_json = JSON.stringify(b.asignaciones);\nif (b.links !== undefined && b.links_json === undefined) row.links_json = JSON.stringify(b.links);\nif (b.taskDates !== undefined && b.taskDates_json === undefined) row.taskDates_json = JSON.stringify(b.taskDates);\nreturn [{ json: row }];"
      },
      "id": "d4000004-0000-0000-0000-000000000003",
      "name": "Preparar fila",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
