    {
      "parameters": {
        "jsCode": "const b = $('Webhook').first().json.body || {};\n/* El hub manda body.mails cuando se suma gente al proyecto ya creado y se le\n   quiere mandar la propuesta. Mismo formato que en wf3: rol, to, nombre,\n   enviar, subject, html. Sin esa clave esta rama no hace nada, así que los\n   updates normales (etapa, equipo, calendario) no disparan ningún mail. */\nif (!Array.isArray(b.mails)) return [];\nreturn b.mails\n  .filter(m => m && m.to && m.html && m.enviar !== false)\n  .map(m => ({ json: {\n    to: String(m.to).trim(),\n    subject: m.subject || ('Propuesta TEAM23 \\u2014 ' + (b.nombre || '')),\n    html: m.html\n  } }));\n"
      },
