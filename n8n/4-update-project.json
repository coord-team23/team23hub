    {
      "parameters": {
        "jsCode": "const cambio = $('\\u00bfCambi\\u00f3 la etapa?').first().json;\nconst filas = $('Leer Projects').all().map(i => i.json);\nconst p = filas.find(r => String(r.id) === cambio.id);\nif (!p) return [];\nconst LABELS = { por_activarse: 'Pre-producci\\u00f3n', activo: 'Ejecutando', entregando: 'Entregando', cierre: 'Listo para cierre', completado: 'Completado' };\nconst EMOJI = { activo: '\\ud83d\\udfe2', entregando: '\\ud83d\\udce6', cierre: '\\ud83d\\udd34', completado: '\\ud83c\\udfc1' };\nconst label = LABELS[cambio.status] || cambio.status;\nconst emoji = EMOJI[cambio.status] || '\\ud83d\\udd01';\nconst out = [];\n\n/* 1. Aviso en el canal -avisos del proyecto (igual que antes) */\nconst canal = String(p.discord_avisos_id || '').replace(/^'+/, '');\nif (canal) out.push({ json: { channelId: canal, content: emoji + ' **' + (p.nombre || 'Proyecto') + '** pas\\u00f3 a **' + label + '**' } });\n\n/* 2. Hito en el canal general, solo etapas principales, con m\\u00ednima info de fechas */\nconst HITOS_GENERAL = ['activo', 'entregando', 'cierre', 'completado'];\nconst general = String($('CONFIG').first().json.discordGeneralId || '').trim();\nif (general && general !== 'PEGAR_ID_DEL_CANAL_GENERAL' && HITOS_GENERAL.includes(cambio.status)) {\n  const cal = $('Leer Calendario').all().map(i => i.json).filter(r => r && String(r.project_id) === cambio.id);\n  const fases = cal.filter(r => (r.tipo || 'fase') !== 'hito');\n  const hitos = cal.filter(r => r.tipo === 'hito');\n  const dmy = s => { const t = String(s || '').slice(0, 10).split('-'); return t.length === 3 ? t[2] + '/' + t[1] : String(s || ''); };\n  const inicios = fases.map(r => r.inicio).filter(Boolean).sort();\n  const fines = fases.map(r => r.fin || r.inicio).filter(Boolean).sort();\n  const partes = [];\n  if (inicios.length && fines.length) partes.push('\\ud83d\\udcc5 ' + dmy(inicios[0]) + ' al ' + dmy(fines[fines.length - 1]));\n  if (cambio.status !== 'completado') {\n    const hoy = new Date().toISOString().slice(0, 10);\n    const prox = hitos.filter(h => (h.inicio || '') >= hoy).sort((a, b) => String(a.inicio).localeCompare(String(b.inicio)))[0];\n    if (prox) partes.push('Pr\\u00f3ximo hito: ' + (prox.fase || 'Hito') + ' ' + dmy(prox.inicio));\n  }\n  const lineas = [emoji + ' **' + (p.nombre || 'Proyecto') + '** \\u2192 ' + label];\n  if (partes.length) lineas.push(partes.join(' \\u00b7 '));\n  out.push({ json: { channelId: general, content: lineas.join('\\n') } });\n}\nreturn out;"
      },
