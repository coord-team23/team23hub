      "id": "hh000007-0000-0000-0000-766387863782",
      "name": "Leer Calendario",
      "type": "n8n-nodes-base.googleSheets",
      "typeVersion": 4.5,
      "position": [
        1000,
        -100
      ],
      "alwaysOutputData": true,
      "executeOnce": true,
      "credentials": {
        "googleSheetsOAuth2Api": {
          "id": "REEMPLAZAR",
          "name": "Google Sheets account"
        }
      }
    },
    {
      "parameters": {
        "jsCode": "const email = String($('Validar login').first().json.email || '').toLowerCase();\nconst projRows = $('Leer Projects').all().map(i => i.json);\nconst calRows = $('Leer Calendario').all().map(i => i.json);\nconst safe = (v, fb) => { try { const x = JSON.parse(v); return x ?? fb; } catch(e) { return fb; } };\nconst out = [];\nfor (const p of projRows) {\n  if (!p || !p.id) continue;\n  /* un borrador es un plan interno sin confirmar: no es un proyecto todavía.\n     Sin este filtro le aparecía al proveedor como uno normal, con links y calendario. */\n  if (String(p.status || '').trim() === 'borrador') continue;\n  const asigs = safe(p.asignaciones_json, {});\n  const roles = [];\n  Object.entries(asigs).forEach(([tarea, rows]) => {\n    (rows || []).forEach(r => {\n      if (r && r.email && String(r.email).trim().toLowerCase() === email && (!r.estado || r.estado === 'confirmado')) roles.push(tarea);\n    });\n  });\n  if (!roles.length) continue;\n  const links = safe(p.links_json, {});\n  const taskDates = safe(p.taskDates_json, {});\n  const cal = calRows.filter(c => String(c.project_id || '') === String(p.id)).map(c => ({ tipo: c.tipo === 'hito' ? 'hito' : 'fase', fase: c.fase || '', inicio: c.inicio || '', fin: c.fin || '', notas: c.notas || '' }));\n  Object.entries(taskDates).forEach(([tarea, d]) => {\n    if (d && (d.inicio || d.fin)) cal.push({ tipo: 'fase', fase: tarea, inicio: d.inicio || '', fin: d.fin || d.inicio || '', notas: d.notas || '' });\n  });\n  out.push({\n    id: p.id, nombre: p.nombre || '', cliente: p.cliente || '', agencia: p.agencia || '', productora: p.productora || '',\n    status: p.status || 'por_activarse',   /* mismo default que wf2, para que las dos vistas cuenten lo mismo */ year: p.year || '', sintesis: p.sintesis || '', storyboard_url: p.storyboard_url || '',\n    misRoles: [...new Set(roles)],\n    /* set completo de links del proyecto: el portal muestra las carpetas de Drive\n       y los documentos. El acceso real lo sigue gobernando Drive, no esta lista;\n       `desglose` queda afuera a propósito por si lleva presupuesto. */\n    links: ['driveRoot','coord','supervision','footage','recursos','editables','finales','brief','feedback','notas','frameio']\n      .reduce((acc, k) => { if (links[k]) acc[k] = links[k]; return acc; }, {}),\n    calendario: cal\n  });\n}\nreturn [{ json: { projects: out } }];"
      },
      "id": "hh000007-0000-0000-0000-000000000005",
      "name": "Filtrar por proveedor",
